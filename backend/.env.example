OH_ENV=development
OH_DATABASE_URL=postgresql+psycopg://oh_app:replace-me@127.0.0.1:5432/occupational_health
OH_REDIS_URL=redis://:replace-me@127.0.0.1:6379/0
OH_QDRANT_URL=http://127.0.0.1:6333
OH_QDRANT_API_KEY=replace-me
OH_STORAGE_ROOT=../var/data
OH_MODEL_ROOT=D:/models
OH_SESSION_SECRET=replace-with-32-random-bytes
OH_SESSION_TTL_MINUTES=480
OH_SESSION_IDLE_MINUTES=60
OH_MAX_FILE_SIZE_BYTES=104857600
OH_MAX_PAGES_PER_FILE=500
OH_MAX_FILES_PER_WEB_BATCH=20
OH_MAX_QUERY_CHARACTERS=512
OH_DEFAULT_TOP_K=5
OH_MAX_TOP_K=5
OH_CHUNK_TARGET_TOKENS=512
OH_CHUNK_MAX_TOKENS=768
OH_CHUNK_OVERLAP_TOKENS=64
# 父子块：父块保持语义完整，子块负责检索命中
OH_PARENT_CHUNK_TARGET_TOKENS=768
OH_PARENT_CHUNK_MAX_TOKENS=1200
OH_CHILD_CHUNK_TARGET_TOKENS=220
OH_CHILD_CHUNK_MAX_TOKENS=320
OH_CHILD_CHUNK_OVERLAP_TOKENS=40
OH_TEXT_LAYER_MIN_CHARS=1
OH_OCR_LOW_CONFIDENCE=0.75
OH_DOCUMENT_MIN_CHARS=50
OH_RATE_LIMIT_PER_MINUTE=60
OH_UPLOAD_LIMIT_PER_MINUTE=10
OH_JOB_HISTORY_KEEP=10
OH_RRF_K=60
OH_RECALL_CANDIDATES=50
OH_LOG_RETENTION_DAYS=180
OH_QWEN_MODEL_ID=Qwen/Qwen3-Embedding-0.6B
OH_QWEN_REVISION=master
OH_QWEN_QUERY_INSTRUCTION=Given an occupational-health query, retrieve relevant passages
OH_EMBEDDING_URL=http://127.0.0.1:8001
OH_EMBEDDING_TIMEOUT_SECONDS=60
OH_EMBEDDING_WARMUP_TIMEOUT_SECONDS=300
OH_EMBEDDING_MAX_RETRIES=3
OH_EMBEDDING_RETRY_BACKOFF_SECONDS=2.0
OH_EMBEDDING_BATCH_SIZE=8
OH_PIPELINE_COMMIT_EVERY=20
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# 公网部署：启用后由后端直接托管前端构建产物（cd backend 后相对路径）
# OH_FRONTEND_DIST=../frontend/dist
# OH_COOKIE_SECURE=true
# 生产环境务必替换会话密钥
# OH_ENV=production

# 公网 MCP 允许的 Host，多个用逗号分隔（Cloudflare 会转发 Host: 你的域名）
# OH_MCP_ALLOWED_HOSTS=kb.guanmingkun.ltd